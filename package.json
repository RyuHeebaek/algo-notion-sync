{
  "name": "algo-notion-sync",
  "version": "1.0.0",
  "description": "Chrome Manifest V3 Extension for syncing SWEA and JUNGOL submissions to Notion",
  "private": true,
  "scripts": {
    "build": "npm run build:extension && npm run build:server",
    "build:extension": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "dev:server": "npx tsx watch server/src/index.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.306",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "dotenv": "^16.4.7",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
